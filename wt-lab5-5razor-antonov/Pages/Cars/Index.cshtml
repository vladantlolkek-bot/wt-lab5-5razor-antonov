@page
@model wt_lab5_5razor_antonov.Pages.Cars.IndexModel
@{
    ViewData["Title"] = "Автомобили";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold">🚗 Каталог автомобилей</h1>
            <p class="text-muted">Список доступных машин</p>
        </div>
        <a asp-page="/Cars/Create" class="btn btn-primary shadow-sm">+ Добавить</a>
    </div>

    <div class="row g-4">
        @foreach (var car in Model.Cars)
        {
            <div class="col-12 col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm rounded-4 border-0">
                    <div class="card-body d-flex flex-column">
                        <span class="badge bg-secondary mb-2 align-self-start">ID: @car.Id</span>
                        <h5 class="card-title fw-bold">@car.Brand @car.Model</h5>
                        <p class="text-muted mb-2">Год выпуска: @car.Year</p>
                        <p class="fs-4 fw-bold text-primary mb-2">@car.PricePerDay ₽ <span class="fs-6 text-muted fw-normal">/ сутки</span></p>

                        @if (car.IsAvailable)
                        {
                            <span class="badge bg-success mb-3">Доступен</span>
                        }
                        else
                        {
                            <span class="badge bg-danger mb-3">Занят</span>
                        }

                        <div class="mt-auto d-flex gap-2">
                            <a asp-page="/Cars/Details" asp-route-id="@car.Id" class="btn btn-outline-primary btn-sm">Подробнее</a>
                            <a asp-page="/Cars/Edit" asp-route-id="@car.Id" class="btn btn-outline-warning btn-sm">Изменить</a>
                            <form asp-page-handler="Delete" asp-route-id="@car.Id" method="post" class="d-inline" onsubmit="return confirm('Удалить автомобиль?');">
                                <button type="submit" class="btn btn-outline-danger btn-sm">Удалить</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>